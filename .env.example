# ---------------------------------------------------------------------------
# travelagent credentials. Copy to .env and fill in what you have.
# Nothing here is required to install — but with no token set, every search
# returns empty. Run `travelagent doctor` to see what is live.
# ---------------------------------------------------------------------------

# Duffel — the only source that returns bookable fares you can quote as prices.
# Free test token at https://duffel.com (instant). Production access needs a
# short review. Test tokens start with duffel_test_, live ones with duffel_live_.
DUFFEL_ACCESS_TOKEN=

# Travelpayouts — cached real fares, hotel prices, and the month price calendar
# that powers `cheapest_dates`. Free affiliate signup at travelpayouts.com.
TRAVELPAYOUTS_TOKEN=
# Optional: your affiliate marker, so booking deep links attribute correctly.
TRAVELPAYOUTS_MARKER=

# --- Defaults --------------------------------------------------------------
TRAVELAGENT_CURRENCY=EUR
TRAVELAGENT_MARKET=IT
TRAVELAGENT_LOCALE=en-GB
# Comma-separated. Your realistic departure set, including positioning hubs.
TRAVELAGENT_HOME_AIRPORTS=

# --- Behaviour -------------------------------------------------------------
# Cache TTL in seconds. Kept short on purpose: a stale price is worse than a
# slow one. Live bookable offers are never cached regardless of this setting.
TRAVELAGENT_CACHE_TTL=900
TRAVELAGENT_TIMEOUT=30

# --- Browser-driven reads (optional, off by default) -----------------------
# Reads prices from Google Flights / Booking.com when no API covers the route.
# Requires: pip install 'travelagent[scrape]' && playwright install chromium
TRAVELAGENT_SCRAPING=0
TRAVELAGENT_SCRAPER_HEADLESS=1
# Seconds between browser requests. Do not lower this.
TRAVELAGENT_SCRAPER_INTERVAL=4
# Where to dump HTML + screenshots when a selector stops matching.
TRAVELAGENT_SCRAPER_DEBUG_DIR=./scraper-debug
